{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nebutra/carina/protocol/schemas/task.schema.json",
  "title": "Task",
  "description": "Delegated background work leased to carina-worker.",
  "type": "object",
  "required": ["task_id", "session_id", "workspace_id", "status", "user_prompt", "mode", "created_at", "updated_at"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^task_" },
    "session_id": { "type": "string", "pattern": "^sess_" },
    "workspace_id": { "type": "string", "pattern": "^ws_" },
    "status": { "enum": ["queued", "running", "completed", "degraded", "failed", "cancelled"] },
    "revision": { "type": "integer", "minimum": 1 },
    "continuity": { "type": "object" },
    "user_prompt": { "type": "string" },
    "locale": { "enum": ["en", "zh", "zh-Hant", "ja", "ko", "es", "fr"] },
    "success_criteria": { "type": "array" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "mode": { "const": "dispatch" },
    "summary": { "type": "string" },
    "applied_patches": { "type": "array", "items": { "type": "string" } },
    "tokens_used": { "type": "integer", "minimum": 0 },
    "token_usage_observed": { "type": "boolean" },
    "lease_owner": { "type": "string" },
    "lease_expiry": { "type": "string", "format": "date-time" },
    "lease_generation": { "type": "integer", "minimum": 1 },
    "attempts": { "type": "integer", "minimum": 0 },
    "required_worker_capabilities": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
