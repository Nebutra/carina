---
/** Full-bleed landing hero backed by a production Ratatui capture. */
import brandLockup from '../../assets/carina-horizontal-brand-dark.svg';

interface Props {
  productLabel?: string;
  title: string;
  subtitle: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  trustChips?: string[];
  installCommand?: string;
  installHref?: string;
  imageSrc?: string;
}

const {
  productLabel = 'AI Agent Harness',
  title,
  subtitle,
  primaryCta,
  secondaryCta,
  trustChips = ['Policy before effect', 'Hash-chained audit', 'Identity-bound rollback'],
  installCommand = 'curl -fsSL https://carina.nebutra.com/install.sh | sh',
  installHref,
  imageSrc = '/images/tui-session.webp',
} = Astro.props;

const isZh = Astro.locals.starlightRoute.locale === 'zh-cn';
const resolvedInstallHref =
  installHref ?? (isZh ? '/zh-cn/getting-started/installation/' : '/getting-started/installation/');
const copy = isZh
  ? {
      scene: 'Carina TUI 真实产品界面，展示 transcript、审批、编辑与 composer 状态',
      install: '安装命令',
      copy: '复制',
      copied: '已复制',
      copyLabel: '复制安装命令',
      more: '查看全部安装方式',
    }
  : {
      scene: 'Real Carina TUI showing transcript, approval, edit, and composer status',
      install: 'Install command',
      copy: 'Copy',
      copied: 'Copied',
      copyLabel: 'Copy install command',
      more: 'View all install options',
    };
---

<section class="hero not-content">
  <img
    class="hero__scene"
    src={imageSrc}
    alt={copy.scene}
    width="1256"
    height="656"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__inner">
    <img
      class="hero__lockup"
      src={brandLockup.src}
      alt="Carina"
      width="188"
      height="82"
      decoding="async"
    />
    <p class="hero__product">{productLabel}</p>
    <h1 id="_top" class="hero__title">{title}</h1>
    <p class="hero__subtitle">{subtitle}</p>

    <ul class="hero__trust" role="list">
      {trustChips.map((item) => <li>{item}</li>)}
    </ul>

    <div class="hero__actions">
      <a class="hero__btn hero__btn--primary" href={primaryCta.href}>{primaryCta.label}</a>
      {
        secondaryCta && (
          <a class="hero__btn hero__btn--secondary" href={secondaryCta.href}>
            {secondaryCta.label}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>

    <div class="hero__install" data-hero-install aria-label={copy.install}>
      <span class="hero__install-prompt" aria-hidden="true">$</span>
      <code class="hero__install-command" data-install-command>{installCommand}</code>
      <button
        class="hero__install-copy"
        type="button"
        data-install-copy
        data-copy-success={copy.copied}
        aria-label={copy.copyLabel}
      >
        <span data-install-copy-label>{copy.copy}</span>
      </button>
    </div>
    <a class="hero__install-more" href={resolvedInstallHref}>{copy.more} →</a>
  </div>
</section>

<script>
  function initInstall(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.ready === '1') return;
    root.dataset.ready = '1';
    const button = root.querySelector<HTMLButtonElement>('[data-install-copy]');
    const label = root.querySelector<HTMLElement>('[data-install-copy-label]');
    const command = root.querySelector<HTMLElement>('[data-install-command]')?.textContent?.trim();
    if (!button || !command) return;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command);
        const previous = label?.textContent;
        if (label) label.textContent = button.dataset.copySuccess || 'Copied';
        window.setTimeout(() => {
          if (label) label.textContent = previous || 'Copy';
        }, 1400);
      } catch {
        /* Clipboard access can be unavailable in embedded documentation. */
      }
    });
  }

  function boot() {
    document.querySelectorAll('[data-hero-install]').forEach(initInstall);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(34rem, 68svh, 41rem);
    overflow: hidden;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--polish-code-border);
    background: var(--polish-code-bg);
    color: var(--polish-code-fg);
  }

  .hero__scene,
  .hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__scene {
    z-index: -2;
    object-fit: cover;
    object-position: center 44%;
    opacity: 0.42;
    filter: brightness(0.62) contrast(1.04);
  }

  .hero__shade {
    z-index: -1;
    background: color-mix(in srgb, var(--polish-code-bg) 70%, transparent);
  }

  .hero__inner {
    width: min(calc(100% - var(--spacing-12)), var(--docs-page-max, 72rem));
    margin: 0 auto;
    padding-block: clamp(3rem, 7svh, 4.5rem);
  }

  @media (min-width: 768px) {
    .hero__inner {
      width: min(calc(100% - var(--spacing-20)), var(--docs-page-max, 72rem));
    }
  }

  .hero__lockup {
    display: block;
    width: 11.75rem;
    height: auto;
    margin: 0 0 0.75rem;
  }

  .hero__product {
    margin: 0 0 1rem;
    font-family: var(--docs-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--carina-ion-cyan);
    text-transform: uppercase;
  }

  .hero__title {
    max-width: 46rem;
    margin: 0 0 1rem;
    background: none;
    color: var(--polish-code-fg);
    font-family: var(--docs-font-display);
    font-size: 2.35rem;
    font-weight: 550;
    line-height: 1;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .hero__subtitle {
    max-width: 40rem;
    margin: 0 0 1.35rem;
    color: var(--polish-code-muted);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.2rem;
    margin: 0 0 1.7rem;
    padding: 0;
    list-style: none;
    color: var(--polish-code-muted);
    font-family: var(--docs-font-mono);
    font-size: 0.76rem;
  }

  .hero__trust li {
    position: relative;
    padding-inline-start: 0.85rem;
  }

  .hero__trust li::before {
    content: '';
    position: absolute;
    top: 0.48em;
    left: 0;
    width: 4px;
    height: 4px;
    background: var(--carina-ion-cyan);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero__btn {
    min-height: 2.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0 1.1rem;
    border: 1px solid var(--polish-code-line);
    border-radius: 6px;
    color: var(--polish-code-fg);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--docs-transition),
      border-color var(--docs-transition);
  }

  .hero__btn--primary {
    border-color: var(--carina-ion-cyan);
    background: var(--carina-ion-cyan);
    color: var(--polish-code-bg);
  }

  .hero__btn--primary:hover {
    border-color: var(--carina-ion-cyan-bright);
    background: var(--carina-ion-cyan-bright);
  }

  .hero__btn--secondary:hover {
    border-color: var(--carina-ion-cyan);
    background: color-mix(in srgb, var(--carina-ion-cyan) 10%, transparent);
  }

  .hero__btn:focus-visible,
  .hero__install-copy:focus-visible,
  .hero__install-more:focus-visible {
    outline: 2px solid var(--carina-ion-cyan);
    outline-offset: 3px;
  }

  .hero__install {
    display: flex;
    align-items: center;
    width: min(100%, 40rem);
    min-height: 2.6rem;
    border-block: 1px solid var(--polish-code-line);
    color: var(--polish-code-muted);
  }

  .hero__install-prompt {
    padding-inline: 0.15rem 0.65rem;
    color: var(--carina-ion-cyan);
    font-family: var(--docs-font-mono);
  }

  .hero__install-command {
    flex: 1;
    min-width: 0;
    padding: 0;
    overflow-x: auto;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: var(--polish-code-muted);
    font-family: var(--docs-font-mono);
    font-size: 0.76rem;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .hero__install-command::-webkit-scrollbar {
    display: none;
  }

  .hero__install-copy {
    min-height: 1.9rem;
    margin-inline-start: 0.6rem;
    padding: 0 0.7rem;
    border: 1px solid var(--polish-code-line);
    border-radius: 4px;
    background: transparent;
    color: var(--polish-code-fg);
    font-family: var(--docs-font-sans);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .hero__install-copy:hover {
    border-color: var(--carina-ion-cyan);
    color: var(--carina-ion-cyan);
  }

  .hero__install-more {
    display: inline-block;
    margin-top: 0.65rem;
    color: var(--polish-code-muted);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .hero__install-more:hover {
    color: var(--carina-ion-cyan);
  }

  @media (max-width: 560px) {
    .hero {
      min-height: 74svh;
    }

    .hero__scene {
      object-position: 42% center;
    }

    .hero__inner {
      padding-block: var(--spacing-12);
    }

    .hero__lockup {
      width: 9.75rem;
    }

  }

  @media (min-width: 768px) {
    .hero__title {
      font-size: 3.5rem;
    }

    .hero__subtitle {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__scene {
      opacity: 0.68;
      transform: translateX(52%);
    }
  }

  @media (min-width: 1200px) {
    .hero__title {
      font-size: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__btn,
    .hero__install-copy {
      transition: none;
    }
  }
</style>
