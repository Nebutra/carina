---
/**
 * Landing Hero — above-the-fold product entry (Option A).
 *
 * - Left: copy + CTAs + light install toolstrip (not a second dark code shell)
 * - Right: TerminalFrame as the sole dark product signal
 */
import TerminalFrame from './TerminalFrame.astro';

interface Props {
  brand?: string;
  productLabel?: string;
  title: string;
  subtitle: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  trustChips?: string[];
  showTerminal?: boolean;
  /** One-line install command under CTAs */
  installCommand?: string;
  installHref?: string;
  showInstall?: boolean;
}

const {
  brand = 'Carina',
  productLabel = 'AI Agent Runtime',
  title,
  subtitle,
  primaryCta,
  secondaryCta,
  trustChips = ['Local-first', 'Policy-gated tools', 'Hash-chained audit', 'Rollback'],
  showTerminal = true,
  installCommand = 'curl -fsSL https://carina.nebutra.com/install.sh | sh',
  installHref,
  showInstall = true,
} = Astro.props;

const isZh = Astro.locals.starlightRoute.locale === 'zh-cn';
const resolvedInstallHref =
  installHref ?? (isZh ? '/zh-cn/getting-started/installation/' : '/getting-started/installation/');
const installCopy = isZh
  ? {
      regionLabel: '安装命令',
      buttonLabel: '复制安装命令',
      copy: '复制',
      copied: '已复制',
      more: 'Homebrew · npm · 全部方式',
    }
  : {
      regionLabel: 'Install command',
      buttonLabel: 'Copy install command',
      copy: 'Copy',
      copied: 'Copied',
      more: 'Homebrew · npm · all options',
    };
---

<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__grid" aria-hidden="true"></div>

  <div class:list={['hero__inner', showTerminal && 'hero__inner--split']}>
    <div class="hero__copy">
      <p class="hero__eyebrow docs-animate-in docs-animate-in--1">
        <img
          class="hero__mark"
          src="/carina-symbol.svg"
          alt=""
          width="16"
          height="16"
          decoding="async"
        />
        <span class="hero__brand-label">{brand}</span>
        <span class="hero__divider" aria-hidden="true">·</span>
        <span class="hero__product">{productLabel}</span>
      </p>

      <h1 id="_top" class="hero__title docs-animate-in docs-animate-in--2">{title}</h1>
      <p class="hero__subtitle docs-animate-in docs-animate-in--3">{subtitle}</p>

      {
        trustChips.length > 0 && (
          <ul class="hero__trust docs-animate-in docs-animate-in--3" role="list">
            {trustChips.map((chip) => (
              <li class="hero__chip">
                <span class="hero__chip-dot" aria-hidden="true" />
                {chip}
              </li>
            ))}
          </ul>
        )
      }

      <div class="hero__actions docs-animate-in docs-animate-in--4">
        <a class="hero__btn hero__btn--primary" href={primaryCta.href}>{primaryCta.label}</a>
        {
          secondaryCta && (
            <a class="hero__btn hero__btn--ghost" href={secondaryCta.href}>
              {secondaryCta.label}
              <span class="hero__btn-arrow" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>

      {
        showInstall && (
          <div
            class="hero__install docs-animate-in docs-animate-in--4"
            data-hero-install
            aria-label={installCopy.regionLabel}
          >
            <div class="hero__install-bar">
              <span class="hero__install-prompt" aria-hidden="true">$</span>
              <code class="hero__install-cmd" data-install-cmd>{installCommand}</code>
              <button
                type="button"
                class="hero__install-copy"
                data-install-copy
                data-copy-success={installCopy.copied}
                aria-label={installCopy.buttonLabel}
              >
                <span data-install-copy-label>{installCopy.copy}</span>
              </button>
            </div>
            <a class="hero__install-more" href={resolvedInstallHref}>
              {installCopy.more}
              <span aria-hidden="true"> →</span>
            </a>
          </div>
        )
      }
    </div>

    {
      /* Terminal stays static: docs-rise on this column made chrome look jumpy. */
      showTerminal && (
        <div class="hero__visual">
          <TerminalFrame title="carina — governed session" />
        </div>
      )
    }
  </div>
</section>

<script>
  function initInstall(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.ready === '1') return;
    root.dataset.ready = '1';
    const btn = root.querySelector<HTMLButtonElement>('[data-install-copy]');
    const labelEl = root.querySelector<HTMLElement>('[data-install-copy-label]');
    const cmd = root.querySelector<HTMLElement>('[data-install-cmd]')?.textContent?.trim();
    if (!btn || !cmd) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cmd);
        if (labelEl) {
          const prev = labelEl.textContent;
          labelEl.textContent = btn.dataset.copySuccess || 'Copied';
          btn.classList.add('is-copied');
          window.setTimeout(() => {
            labelEl.textContent = prev;
            btn.classList.remove('is-copied');
          }, 1400);
        }
      } catch {
        /* ignore */
      }
    });
  }
  function boot() {
    document.querySelectorAll('[data-hero-install]').forEach(initInstall);
  }
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--spacing-16) var(--spacing-6) var(--spacing-14);
    border-bottom: 1px solid var(--docs-border-subtle);
  }

  @media (min-width: 768px) {
    .hero {
      padding: clamp(3.5rem, 7vw, 5.5rem) var(--spacing-10) clamp(3.5rem, 6vw, 5rem);
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--docs-page-max, var(--layout-page-max, 72rem));
    margin: 0 auto;
  }

  .hero__inner:not(.hero__inner--split) {
    max-width: 48rem;
    text-align: center;
  }

  .hero__inner:not(.hero__inner--split) .hero__subtitle {
    margin-inline: auto;
  }

  .hero__inner:not(.hero__inner--split) .hero__trust {
    justify-content: center;
  }

  .hero__inner:not(.hero__inner--split) .hero__actions {
    justify-content: center;
  }

  .hero__inner:not(.hero__inner--split) .hero__install {
    margin-inline: auto;
    align-items: center;
  }

  .hero__inner--split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-10);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner--split {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 var(--spacing-5);
    padding: 0.3rem 0.8rem 0.3rem 0.45rem;
    border: 1px solid var(--docs-border);
    border-radius: var(--docs-radius-full);
    background: color-mix(in srgb, var(--docs-bg-surface) 92%, transparent);
    color: var(--docs-fg-muted);
    font-family: var(--docs-font-sans);
    font-size: var(--text-caption, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .hero__mark {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    display: block;
  }

  .hero__brand-label {
    color: var(--docs-fg);
    font-weight: 600;
  }

  .hero__divider {
    color: var(--docs-fg-subtle);
    font-weight: 400;
  }

  .hero__title {
    margin: 0 0 var(--spacing-4);
    font-family: var(--docs-font-display);
    font-size: clamp(2rem, 4.8vw, 3.15rem);
    font-weight: 550;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--docs-fg);
    text-wrap: balance;
    font-optical-sizing: auto;
    word-break: keep-all;
    line-break: strict;
  }

  .hero__subtitle {
    margin: 0 0 var(--spacing-5);
    max-width: 36rem;
    font-family: var(--docs-font-sans);
    font-size: clamp(0.98rem, 1.35vw, 1.1rem);
    font-weight: 400;
    line-height: 1.65;
    color: var(--docs-fg-muted);
    text-wrap: pretty;
  }

  .hero__trust {
    list-style: none;
    margin: 0 0 var(--spacing-7);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.65rem;
  }

  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.65rem 0.28rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--docs-border-subtle);
    background: color-mix(in srgb, var(--docs-bg-surface) 70%, transparent);
    color: var(--docs-fg-muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

  .hero__chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--docs-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--docs-accent) 18%, transparent);
    flex-shrink: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    align-items: center;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0 1.35rem;
    border-radius: var(--docs-radius-full, 999px);
    font-family: var(--docs-font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 160ms cubic-bezier(0.2, 0, 0, 1),
      border-color 160ms cubic-bezier(0.2, 0, 0, 1),
      color 160ms cubic-bezier(0.2, 0, 0, 1),
      box-shadow 160ms cubic-bezier(0.2, 0, 0, 1),
      transform 160ms cubic-bezier(0.2, 0, 0, 1);
  }

  .hero__btn:focus-visible {
    outline: 2px solid var(--docs-focus);
    outline-offset: 2px;
  }

  .hero__btn--primary {
    background: var(--docs-accent);
    color: var(--docs-on-accent, #0d1214);
    -webkit-text-fill-color: var(--docs-on-accent, #0d1214);
    border: 1px solid color-mix(in srgb, var(--docs-accent) 80%, var(--docs-fg));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--docs-accent) 25%, transparent),
      0 8px 24px -12px color-mix(in srgb, var(--docs-accent) 55%, transparent);
  }

  .hero__btn--primary:hover {
    background: var(--docs-accent-hover, var(--docs-accent));
    border-color: var(--docs-accent-hover, var(--docs-accent));
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--docs-accent) 35%, transparent),
      0 12px 28px -10px color-mix(in srgb, var(--docs-accent) 50%, transparent);
  }

  .hero__btn--primary:active {
    transform: translateY(0);
  }

  .hero__btn--ghost {
    background: transparent;
    color: var(--docs-fg);
    -webkit-text-fill-color: var(--docs-fg);
    border: 1px solid var(--docs-border);
  }

  .hero__btn--ghost:hover {
    border-color: color-mix(in srgb, var(--docs-fg) 30%, var(--docs-border));
    background: color-mix(in srgb, var(--docs-fg) 4%, transparent);
    transform: translateY(-1px);
  }

  .hero__btn--ghost:hover .hero__btn-arrow {
    transform: translateX(3px);
  }

  .hero__btn-arrow {
    display: inline-block;
    transition: transform 160ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* Light install toolstrip — secondary to CTAs; terminal keeps the only void shell */
  .hero__install {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    margin-top: var(--spacing-6);
    max-width: 34rem;
    width: 100%;
  }

  .hero__install-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    min-height: 2.5rem;
    padding: 0.3rem 0.3rem 0.3rem 0.75rem;
    border: 1px solid var(--docs-border-subtle);
    border-radius: 10px;
    background: color-mix(in srgb, var(--docs-bg-surface) 88%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--docs-fg) 3%, transparent);
  }

  .hero__install-prompt {
    flex-shrink: 0;
    font-family: var(--docs-font-mono);
    font-size: 0.8125rem;
    color: var(--docs-accent);
    user-select: none;
  }

  .hero__install-cmd {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    font-family: var(--docs-font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--docs-fg-muted);
    white-space: nowrap;
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
  }

  .hero__install-cmd::-webkit-scrollbar {
    display: none;
  }

  .hero__install-copy {
    appearance: none;
    flex-shrink: 0;
    min-height: 1.9rem;
    min-width: 3.5rem;
    padding: 0 0.7rem;
    border: 0;
    border-radius: 7px;
    background: var(--docs-accent);
    color: var(--docs-on-accent, #0d1214);
    font-family: var(--docs-font-sans);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      transform 150ms ease;
  }

  .hero__install-copy:hover {
    background: var(--docs-accent-hover, var(--docs-accent));
  }

  .hero__install-copy.is-copied {
    background: color-mix(in srgb, var(--docs-success, #6bcf8e) 85%, var(--docs-fg));
    color: var(--docs-on-accent, #0d1214);
  }

  .hero__install-copy:focus-visible {
    outline: 2px solid var(--docs-focus);
    outline-offset: 2px;
  }

  .hero__install-more {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--docs-fg-subtle);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .hero__install-more:hover {
    color: var(--docs-accent);
  }

  .hero__visual {
    min-width: 0;
  }

  .hero__glow {
    pointer-events: none;
    position: absolute;
    inset: -30% -10% auto;
    height: 75%;
    background:
      radial-gradient(
        ellipse 55% 50% at 20% 0%,
        color-mix(in srgb, var(--docs-accent) 14%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 45% 40% at 80% 10%,
        color-mix(in srgb, var(--docs-brand-mark, var(--docs-accent)) 8%, transparent),
        transparent 65%
      );
    z-index: 0;
  }

  .hero__grid {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.28;
    background-image:
      linear-gradient(color-mix(in srgb, var(--docs-border-subtle) 55%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--docs-border-subtle) 55%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at 50% 20%, black 8%, transparent 72%);
  }

  @media (max-width: 959px) {
    .hero__visual {
      order: -1;
      max-width: 36rem;
      margin-inline: auto;
      width: 100%;
    }

    .hero__inner--split .hero__copy {
      text-align: center;
    }

    .hero__inner--split .hero__subtitle {
      margin-inline: auto;
    }

    .hero__inner--split .hero__trust {
      justify-content: center;
    }

    .hero__inner--split .hero__actions {
      justify-content: center;
    }

    .hero__inner--split .hero__install {
      margin-inline: auto;
      align-items: center;
    }

    .hero__inner--split .hero__install-more {
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__btn,
    .hero__btn-arrow {
      transition: none;
    }
  }
</style>
