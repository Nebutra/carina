---
/**
 * Landing terminal — the single dark product signal on the cream hero.
 * Intentionally denser than docs code blocks: window chrome + one climax frame.
 *
 * Traffic-light dots use spans (not <i>) with a fixed chrome track so they
 * never baseline-wobble or “bounce” relative to the title/badge.
 */
interface Props {
  title?: string;
  lines?: { tone?: 'muted' | 'accent' | 'ok' | 'default' | 'dim'; text: string }[];
}

const {
  title = 'carina — governed session',
  lines = [
    { tone: 'muted', text: '$ carina run "fix the failing test"' },
    { tone: 'dim', text: 'session  sess_01J…  ·  profile  safe-edit' },
    { tone: 'accent', text: '→ FileRead     src/parser.go      allowed' },
    { tone: 'accent', text: '→ PatchApply   parser.go:142      approval?' },
    { tone: 'ok', text: '✓ applied  ·  audit chained  ·  rollback ready' },
  ],
} = Astro.props;
---

<figure class="term term--product">
  <div class="term__chrome">
    <span class="term__dots" aria-hidden="true">
      <span class="term__dot term__dot--close"></span>
      <span class="term__dot term__dot--min"></span>
      <span class="term__dot term__dot--max"></span>
    </span>
    <span class="term__title">{title}</span>
    <span class="term__badge" aria-hidden="true">live</span>
  </div>
  {/* Whitespace inside <pre> is literal — keep each span on a single line. */}
  <pre class="term__body" tabindex="0"><code>{lines.map((line) => <span class:list={['term__line', line.tone && `term__line--${line.tone}`]}>{line.text}</span>)}</code></pre>
</figure>

<style>
  .term {
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--carina-ion-cyan, var(--docs-accent)) 18%, var(--carina-border-subtle, var(--docs-border-subtle)));
    border-radius: 14px;
    background: var(--carina-code-void, #0f1416);
    overflow: hidden;
    text-align: left;
    /* Isolate paint so entrance/parent transforms cannot re-composite dots */
    transform: translateZ(0);
    isolation: isolate;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--docs-fg) 4%, transparent),
      0 1px 0 color-mix(in srgb, var(--carina-ion-cyan, var(--docs-accent)) 12%, transparent) inset,
      0 28px 56px -24px color-mix(in srgb, #000 55%, transparent),
      0 0 40px -12px color-mix(in srgb, var(--carina-ion-cyan, var(--docs-accent)) 22%, transparent);
  }

  .term__chrome {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    /* Fixed track — not min-height — keeps dots/title/badge on one centerline */
    height: 2.25rem;
    min-height: 2.25rem;
    max-height: 2.25rem;
    padding: 0 0.85rem;
    box-sizing: border-box;
    border-bottom: 1px solid color-mix(in srgb, var(--carina-border-subtle, #2a3336) 90%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--carina-surface-raised, #1c2527) 92%, #fff 4%),
      var(--carina-surface, #141b1d)
    );
  }

  .term__dots {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    flex-shrink: 0;
    height: 8px;
    line-height: 0;
    /* Kill any residual italic / font metrics from UA styles */
    font-size: 0;
  }

  .term__dot {
    display: block;
    width: 8px;
    height: 8px;
    flex: 0 0 8px;
    border-radius: 50%;
    /* Solid fills — no alpha mix (avoids subpixel “shimmer” on dark chrome) */
    background: #5c6366;
  }

  .term__dot--close {
    background: #ff5f57;
  }
  .term__dot--min {
    background: #febc2e;
  }
  .term__dot--max {
    background: #28c840;
  }

  .term__title {
    flex: 1;
    min-width: 0;
    font-family: var(--docs-font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--carina-dust, var(--docs-fg-muted));
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term__badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    height: 1.25rem;
    font-family: var(--docs-font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--carina-ion-cyan, var(--docs-accent));
    padding: 0 0.4rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--carina-ion-cyan, var(--docs-accent)) 35%, transparent);
    background: color-mix(in srgb, var(--carina-ion-cyan, var(--docs-accent)) 10%, transparent);
  }

  .term__body {
    margin: 0;
    padding: 1.05rem 1.15rem 1.2rem;
    font-family: var(--docs-font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--carina-starlight, #f3f0e8);
    overflow-x: auto;
    tab-size: 2;
    background:
      radial-gradient(
        ellipse 80% 60% at 100% 0%,
        color-mix(in srgb, var(--carina-ion-cyan, var(--docs-accent)) 6%, transparent),
        transparent 55%
      ),
      var(--carina-code-void, #0f1416);
  }

  .term__line {
    display: block;
    white-space: pre;
  }

  .term__line--muted {
    color: color-mix(in srgb, var(--carina-starlight, #f3f0e8) 72%, transparent);
  }

  .term__line--dim {
    color: var(--carina-dust, #8b9699);
  }

  .term__line--accent {
    color: var(--carina-ion-cyan, var(--docs-accent));
  }

  .term__line--ok {
    color: var(--carina-spectral-green, var(--docs-success, #6bcf8e));
  }

  .term__line--default {
    color: var(--carina-starlight, #f3f0e8);
  }
</style>
