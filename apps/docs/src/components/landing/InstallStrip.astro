---
/**
 * @deprecated Prefer the light install toolstrip built into Hero (Option A).
 * Kept for one-off embeds; homepage no longer mounts this section.
 */
interface Props {
  command?: string;
  href?: string;
  label?: string;
}

const {
  command = 'curl -fsSL https://carina.nebutra.com/install.sh | sh',
  href = '/getting-started/installation/',
  label = 'Install',
} = Astro.props;
const isZh = Astro.locals.starlightRoute.locale === 'zh-cn';
const copy = isZh
  ? {
      regionLabel: '安装 Carina',
      buttonLabel: '复制安装命令',
      copy: '复制',
      copied: '已复制',
      allOptions: '全部安装方式',
      hint: '一条命令装到本机 · 也可选 Homebrew / npm',
    }
  : {
      regionLabel: 'Install Carina',
      buttonLabel: 'Copy install command',
      copy: 'Copy',
      copied: 'Copied',
      allOptions: 'All install options',
      hint: 'One command on your machine · Homebrew & npm also available',
    };
---

<section class="install-strip" aria-label={copy.regionLabel}>
  <div class="install-strip__inner">
    <div class="install-strip__meta">
      <p class="install-strip__label">{label}</p>
      <p class="install-strip__hint">{copy.hint}</p>
    </div>
    <div class="install-strip__bar" data-install-strip>
      <span class="install-strip__prompt" aria-hidden="true">$</span>
      <code class="install-strip__cmd" data-install-cmd>{command}</code>
      <button
        type="button"
        class="install-strip__copy"
        data-install-copy
        data-copy-success={copy.copied}
        aria-label={copy.buttonLabel}
      >
        <span data-install-copy-label>{copy.copy}</span>
      </button>
    </div>
    <a class="install-strip__more" href={href}>{copy.allOptions} →</a>
  </div>
</section>

<script>
  function init(root: Element) {
    if (!(root instanceof HTMLElement) || root.dataset.ready === '1') return;
    root.dataset.ready = '1';
    const btn = root.querySelector<HTMLButtonElement>('[data-install-copy]');
    const labelEl = root.querySelector<HTMLElement>('[data-install-copy-label]');
    const cmd = root.querySelector<HTMLElement>('[data-install-cmd]')?.textContent?.trim();
    if (!btn || !cmd) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cmd);
        if (labelEl) {
          const prev = labelEl.textContent;
          labelEl.textContent = btn.dataset.copySuccess || 'Copied';
          btn.classList.add('is-copied');
          window.setTimeout(() => {
            labelEl.textContent = prev;
            btn.classList.remove('is-copied');
          }, 1400);
        }
      } catch {
        /* ignore */
      }
    });
  }
  function boot() {
    document.querySelectorAll('[data-install-strip]').forEach(init);
  }
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .install-strip {
    padding: 0 var(--spacing-6) var(--spacing-12);
    margin-top: calc(-1 * var(--spacing-2));
  }

  @media (min-width: 768px) {
    .install-strip {
      padding: 0 var(--spacing-10) var(--spacing-14);
    }
  }

  .install-strip__inner {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  .install-strip__meta {
    margin-bottom: 0.75rem;
  }

  .install-strip__label {
    margin: 0 0 0.2rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--docs-fg-subtle);
  }

  .install-strip__hint {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--docs-fg-muted);
    line-height: 1.4;
  }

  .install-strip__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 3rem;
    padding: 0.4rem 0.4rem 0.4rem 0.85rem;
    border: 1px solid var(--polish-code-border, var(--docs-border));
    border-radius: 12px;
    background: var(--polish-code-bg, var(--docs-bg-raised));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--docs-fg) 5%, transparent),
      0 12px 32px -20px color-mix(in srgb, var(--docs-fg) 40%, transparent);
    text-align: start;
  }

  .install-strip__prompt {
    flex-shrink: 0;
    font-family: var(--docs-font-mono);
    font-size: 0.85rem;
    color: var(--docs-accent);
    user-select: none;
  }

  .install-strip__cmd {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    font-family: var(--docs-font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--polish-code-fg, var(--docs-fg));
    white-space: nowrap;
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
  }

  .install-strip__cmd::-webkit-scrollbar {
    display: none;
  }

  .install-strip__copy {
    appearance: none;
    flex-shrink: 0;
    min-height: 2.25rem;
    min-width: 4.25rem;
    padding: 0 0.85rem;
    border: 1px solid color-mix(in srgb, var(--docs-accent) 40%, var(--docs-border));
    border-radius: 8px;
    background: color-mix(in srgb, var(--docs-accent) 12%, transparent);
    color: var(--docs-accent);
    font-family: var(--docs-font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .install-strip__copy:hover {
    background: color-mix(in srgb, var(--docs-accent) 18%, transparent);
    border-color: var(--docs-accent);
  }

  .install-strip__copy.is-copied {
    color: var(--docs-success);
    border-color: color-mix(in srgb, var(--docs-success) 45%, var(--docs-border));
    background: color-mix(in srgb, var(--docs-success) 12%, transparent);
  }

  .install-strip__copy:focus-visible {
    outline: 2px solid var(--docs-focus);
    outline-offset: 2px;
  }

  .install-strip__more {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--docs-fg-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .install-strip__more:hover {
    color: var(--docs-accent);
  }
</style>
