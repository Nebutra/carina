{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carina Harness",
  "version": "0.9.3",
  "identifier": "com.nebutra.carina.harness",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:4173/integrations/web/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Carina Harness",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws: wss: http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
